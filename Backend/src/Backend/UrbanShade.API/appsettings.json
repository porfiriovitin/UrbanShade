{
  "ThermalAnalysis": {
    "Enabled": true,
    "AlgorithmVersion": "1.0",
    "StaleDataThresholdMinutes": 15,
    "RiskThresholds": {
      "Moderate": 27,
      "High": 32,
      "Critical": 39
    }
  },
  "FirstAccess": {
    "TemporaryPasswordHours": 24,
    "TokenMinutes": 10
  },
  "SensorSimulation": {
    "Enabled": true,
    "IntervalMinutes": 5,
    "MinTemperature": 13,
    "MaxTemperature": 38,
    "MinHumidity": 20,
    "MaxHumidity": 95,
    "MaxTemperatureVariation": 0.5,
    "MaxHumidityVariation": 2.0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
